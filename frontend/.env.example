# Copy to .env.local for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables.
#
# BOTH are server-side only. Neither has the NEXT_PUBLIC_ prefix, which is deliberate:
# a NEXT_PUBLIC_ variable is compiled into the JavaScript the browser downloads, so the token
# would be readable by anyone who opened the page. These are read only inside the proxy route,
# which runs on Vercel's server.

# Where the engine is reachable: HOST AND PORT ONLY, with no path and no trailing slash.
#
#   right:  http://20.0.0.1:8000
#   wrong:  http://20.0.0.1:8000/api     <- every request becomes /api/api/..., the engine 404s,
#                                           and the dashboard used to render that as a calm, empty
#                                           market (F-050)
#   wrong:  http://20.0.0.1:8000/
#   wrong:  https://...                  <- there is no certificate on the VM
#
# http is correct here and is not a mistake on your part: your browser still loads the dashboard
# over HTTPS, and only Vercel's server speaks plain HTTP to the VM. See HOSTING.md's HTTPS appendix
# for closing that gap when it matters.
CT_API_BASE=http://YOUR_VM_PUBLIC_IP:8000

# Must match CT_SERVER__AUTH_TOKEN on the VM exactly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CT_API_TOKEN=
