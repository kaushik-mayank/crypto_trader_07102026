# Copy to /etc/crypto-trader/env on the VM, fill in, then:
#   sudo chown root:crypto /etc/crypto-trader/env
#   sudo chmod 640 /etc/crypto-trader/env
#
# 640 and root-owned: the service user can read it, nothing else can, and the service user cannot
# modify it.

# ---- where things live -----------------------------------------------------------------------
CT_ENVIRONMENT=azure
CT_PATHS__STATE_DB=/opt/crypto-trader/data/state.db
CT_PATHS__DATA_DIR=/opt/crypto-trader/data
CT_PATHS__LOG_DIR=/opt/crypto-trader/logs
CT_PATHS__PARAMETERS_FILE=/opt/crypto-trader/config/parameters.toml

# ---- the API --------------------------------------------------------------------------------
# 0.0.0.0 means "listen on the machine's network interface", so Vercel can reach it directly.
#
# The app REFUSES TO START on a non-loopback address without a token. That guard is the whole
# safety model here, and it is deliberately not optional: an open port with no password is not a
# supported configuration, so the process will not come up in one.
CT_SERVER__HOST=0.0.0.0
CT_SERVER__PORT=8000

# Must match CT_API_TOKEN in Vercel exactly. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotate it (here and in Vercel, then redeploy) if the log ever shows a steady stream of
# `api_requests_refused` from one address.
CT_SERVER__AUTH_TOKEN=

# Leave this false. It exists for the tunnel setup, which this deployment does not use; on a
# direct bind the non-loopback address already makes the token mandatory.
CT_SERVER__PUBLIC_VIA_TUNNEL=false

# ---- CoinDCX credentials: leave both EMPTY ---------------------------------------------------
# Nothing this system uses needs authentication (docs/findings.md F-019). They exist only so the
# path is there if the one signed endpoint is ever needed.
#
# If you ever do fill these in: the key must have NO trading and NO withdrawal permission. Nothing
# in this codebase can place, cancel or transfer anything — there is no such code and a test fails
# the build if an order or wallet address ever appears in it — but a read-only key also means a
# leaked key cannot be used against you.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ---- Telegram notifications: OPTIONAL ---------------------------------------------------------
# Only needed if you want BTCUSDT C3-C suggestions forwarded to Telegram. Leave the whole section
# out and nothing changes: crypto-notify simply refuses to start, and the other two services never
# notice. See TELEGRAM_HOSTING.md for how to get these two values.
#
# The token is a credential. This file is root-owned 0640 for exactly that reason, and the notifier
# never writes it to a log — it prints a length and the last four characters instead.
CT_TELEGRAM__BOT_TOKEN=
CT_TELEGRAM__CHAT_ID=

# Everything below is optional and has a sensible default. The first two are the safety filter:
# changing them changes WHICH suggestions get forwarded, so leave them alone unless that is what
# you intend. `python -m notify --check` prints what the filter resolved to.
#CT_TELEGRAM__ASSET=BTCUSDT
#CT_TELEGRAM__STRATEGY=C3-C
# How often to look for changes, in seconds. Minimum 5; the engine only evaluates once a minute,
# so anything under 30 mostly re-reads the same rows.
#CT_TELEGRAM__POLL_SECONDS=30
# Send messages silently (no phone chime).
#CT_TELEGRAM__SILENT=false
